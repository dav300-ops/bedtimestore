# Server & Networking
PORT=3000
NODE_ENV=development

# MySQL Database Connection (Optional - defaults to in-memory fallback store if unreachable)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=bedtime_admin
MYSQL_PASSWORD=bedtime_secure_password_2026
MYSQL_DATABASE=bedtime_store
# Or complete connection URI:
# MYSQL_URI=mysql://user:password@host:3306/bedtime_store

