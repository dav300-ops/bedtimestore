# ==============================================================================
# THE BEDTIME STORE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.development for local work or .env.production for deployment.
# ==============================================================================

# Server Environment Mode: 'development' | 'production'
NODE_ENV=development

# HTTP Server Port (Port 3000 recommended for AI Studio dev server)
PORT=3000

# Relational Database Connection (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=thebedtime_str
DB_PASSWORD=your_secure_db_password
DB_NAME=thebedtime_store

# Enable SSL for cloud database providers (AWS RDS, GCP Cloud SQL, PlanetScale)
# Options: 'true' | 'false'
DB_SSL=false

# Allowed Origin for Cross-Origin Resource Sharing (no wildcards in production)
CORS_ORIGIN=http://localhost:3000

# Client API Base URL (leave empty by default for same-origin relative '/api')
VITE_API_BASE_URL=

# Application Release Version (used for automatic cache invalidation)
VITE_APP_VERSION=v1.0.0
