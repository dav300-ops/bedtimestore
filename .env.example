# ==============================================================================
# THE BEDTIME STORE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.development for local work or .env.production for deployment.
# ==============================================================================

# Server Environment Mode: 'development' | 'production'
NODE_ENV=development

# HTTP Server Port (Port 3000 recommended for AI Studio dev server)
PORT=3000

# Relational Database Connection (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=thebedtime_str
DB_PASSWORD=your_secure_db_password
DB_NAME=thebedtime_store

# Enable SSL for cloud database providers (AWS RDS, GCP Cloud SQL, PlanetScale)
# Options: 'true' | 'false'
DB_SSL=false

# Allowed Origin for Cross-Origin Resource Sharing (no wildcards in production)
CORS_ORIGIN=http://localhost:3000

# Client API Base URL (leave empty by default for same-origin relative '/api')
VITE_API_BASE_URL=

# Application Release Version (used for automatic cache invalidation)
VITE_APP_VERSION=v1.0.0

# Optional: One-time superadmin recovery seed (set ONLY while running `npm run seed:superadmin`, then remove)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# ==============================================================================
# ADMIN PASSWORDLESS EMAIL CODE LOGIN (OTP) & GMAIL SMTP
# ==============================================================================
# Enable/disable Admin Email Code Login ('true' | 'false')
OTP_LOGIN_ENABLED=true
# Optional comma-separated domain restriction (e.g. thebedtimestore.bh). Leave empty for any admin email domain.
OTP_ALLOWED_DOMAINS=
# Code validity window in minutes
OTP_EXPIRY_MINUTES=10

# Gmail SMTP Settings (requires 2-Step Verification + 16-char Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_boutique_sender@gmail.com
SMTP_APP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_NAME=Deluxe Bedtime Store
